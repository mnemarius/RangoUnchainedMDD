	<artifactId>no.ntnu.tdt4250.rango.gamemode.dsl.tests</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>eclipse-test-plugin</packaging>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<configuration>
					<!-- Xtext's testing bundle also brings JUnit 4; the tests are JUnit 6 (Jupiter) -->
					<providerHint>junit6</providerHint>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
