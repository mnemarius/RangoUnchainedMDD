' Generated from gamemode.ecore. Render with: java -jar plantuml.jar metamodel.puml
@startuml metamodel
!pragma layout elk
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFDF7
  BorderColor #6D4C41
}
hide empty members
hide circle
left to right direction
abstract class WinCondition {
}
class WaveSchedule {
  loop : Boolean [0..1]
  escalation : Int [0..1]
  --
  <<nonNegativeEscalation>>
  <<escalationNeedsLoop>>
}
enum Direction {
  LEFT
  RIGHT
}
class Level {
  title : String [0..1]
  /number : Int [0..1]
  /popsToClear : Int [0..1]
  /maxScore : Int [0..1]
  --
  <<distinctConditionKinds>>
  <<noSimultaneousOutcome>>
  <<winnable>>
  <<endsSomehow>>
  <<healthDepletedWhenHarmful>>
}
abstract class NamedElement {
  name : String
  --
  <<nameUniqueAmongSiblings>>
}
abstract class Positioned {
  x : Float
  y : Float
  --
  <<insideArena>>
}
class EnemyType {
  sprite : String
  scale : Float [0..1]
  bounce : Float [0..1]
  speed : Float [0..1]
  points : Int [0..1]
  /producedTypes : EnemyType [*]
  --
  <<positiveScale>>
  <<positiveBounce>>
  <<positiveSpeed>>
  <<nonNegativePoints>>
  <<distinctEffectKinds>>
  <<oneInstantEffect>>
}
class Edition {
  title : String [0..1]
}
enum DifficultyTier {
  EASY
  MEDIUM
  HARD
}
abstract class InstantEffect {
  amount : Int
  --
  <<positiveAmount>>
}
class Damage {
}
abstract class Obstacle {
}
class Heal {
}
abstract class TimedEffect {
  duration : Float
  --
  <<positiveDuration>>
}
abstract class SplitRule {
}
class SpeedChange {
  factor : Float
  --
  <<factorChangesSpeed>>
}
class Poison {
  amount : Int
  interval : Float
  --
  <<positiveAmount>>
  <<intervalWithinDuration>>
}
class PowerUp {
  sprite : String
  --
  <<distinctEffectKinds>>
  <<oneInstantEffect>>
}
class PlayerProfile {
  character : String [0..1]
  health : Int
  maxHealth : Int [0..1]
  speed : Float [0..1]
  tongueTime : Float [0..1]
  cooldown : Float [0..1]
  graceTime : Float [0..1]
  --
  <<positiveHealth>>
  <<healthWithinMaximum>>
  <<positiveSpeed>>
  <<positiveTongueTime>>
  <<nonNegativeTimes>>
}
class GameMode {
  title : String
  description : String [0..1]
  gravity : Float [0..1]
  /enemyTypes : EnemyType [*]
  /popsToClear : Int [0..1]
  /maxScore : Int [0..1]
  /powerUps : PowerUp [*]
  /effectiveDrops : DropTable [*]
  --
  <<positiveGravity>>
  <<everyEnemyDrops>>
}
class SpeedBonus {
  maxFactor : Float [0..1]
  duration : Float [0..1]
  --
  <<bonusAboveOne>>
  <<positiveDuration>>
}
class Wave {
  delay : Float [0..1]
  /number : Int [0..1]
  /popsToClear : Int [0..1]
  --
  <<nonNegativeDelay>>
}
abstract class PlayerEffect {
}
class Arena {
  background : String
  playerStart : Float [0..1]
  --
  <<playerStartInside>>
}
class Block {
  width : Int
  height : Int
  --
  <<positiveSize>>
}
abstract class Trigger {
  affects : Target [0..1]
}
class JumpPad {
  launch : Float
  --
  <<positiveLaunch>>
}
class Teleporter {
  --
  <<notToItself>>
  <<targetInSameArena>>
}
enum Target {
  ALL
  ENEMIES
  PLAYER
}
abstract class SpawnStrategy {
  /popsToClear : Int [0..1]
}
class FixedLayout {
}
class EnemySpawn {
  size : Int [0..1]
  count : Int [0..1]
  direction : Direction [0..1]
  /popsToClear : Int [0..1]
  --
  <<sizeInRange>>
  <<positiveCount>>
}
class DropTable {
  chance : Float
  /totalWeight : Int [0..1]
  --
  <<chanceIsPercentage>>
  <<distinctPowerUps>>
  <<oneTablePerEnemy>>
}
class Drop {
  weight : Int [0..1]
  /probability : Float [0..1]
  /share : Float [0..1]
  --
  <<positiveWeight>>
}
class Difficulty {
  tier : DifficultyTier
  --
  <<distinctTargets>>
  <<onePerTier>>
}
class Vanish {
}
class Modifier {
  target : ModifierTarget
  factor : Float
  --
  <<positiveFactor>>
}
enum ModifierTarget {
  ENEMY_SPEED
  ENEMY_POINTS
  PLAYER_HEALTH
  PLAYER_SPEED
  DROP_CHANCE
  WAVE_DELAY
}
abstract class LoseCondition {
}
class Cleared {
}
class Split {
  fragments : Int
  launchSpeed : Float [0..1]
  /resultType : EnemyType
  /spacing : Float
  --
  <<atLeastOneFragment>>
  <<atMostSixteenFragments>>
  <<positiveLaunchSpeed>>
}
class TimeSurvived {
  seconds : Float
  --
  <<positiveSeconds>>
}
class Shield {
}
class WavesSurvived {
  count : Int
  --
  <<positiveCount>>
}
class HealthDepleted {
}
class TimeLimit {
  seconds : Float
  --
  <<positiveSeconds>>
}
Edition *--> "*" PowerUp : powerUps
WinCondition <|-- Cleared
Edition *--> "1..*" PlayerProfile : players
Trigger <|-- Teleporter
Edition *--> "*" EnemyType : enemyTypes
Edition *--> "1..*" GameMode : modes
NamedElement <|-- Obstacle
Difficulty *--> "*" Modifier : modifiers
EnemyType *--> "1" SplitRule : splitRule
NamedElement <|-- Edition
Edition *--> "*" DropTable : drops
SplitRule <|-- Vanish
InstantEffect <|-- Heal
Level *--> "*" WinCondition : win
InstantEffect <|-- Damage
PlayerEffect <|-- TimedEffect
TimedEffect <|-- Shield
PowerUp *--> "1..*" PlayerEffect : effects
NamedElement <|-- PowerUp
NamedElement <|-- PlayerProfile
GameMode --> "1" PlayerProfile : player
TimedEffect <|-- Poison
Level *--> "1" Arena : arena
Level *--> "1" SpawnStrategy : spawning
Edition *--> "*" Difficulty : difficulties
SplitRule <|-- Split
Level *--> "1..*" LoseCondition : lose
PlayerEffect <|-- InstantEffect
WinCondition <|-- TimeSurvived
WinCondition <|-- WavesSurvived
LoseCondition <|-- TimeLimit
GameMode *--> "1..*" Level : levels
FixedLayout *--> "1..*" EnemySpawn : spawns
GameMode *--> "0..1" SpeedBonus : speedBonus
GameMode *--> "*" DropTable : drops
NamedElement <|-- GameMode
Positioned <|-- Obstacle
Arena *--> "*" Obstacle : obstacles
Obstacle <|-- Block
Wave *--> "1..*" EnemySpawn : spawns
Obstacle <|-- Trigger
Trigger <|-- JumpPad
Teleporter --> "1" Teleporter : target
LoseCondition <|-- HealthDepleted
SpawnStrategy <|-- FixedLayout
SpawnStrategy <|-- WaveSchedule
EnemySpawn --> "1" EnemyType : type
