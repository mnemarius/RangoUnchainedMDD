// Concrete syntax of the Rango Unchained game mode DSL. The abstract syntax is the hand-made
// metamodel gamemode.ecore (imported, not inferred), so its OCL and Java constraints and its derived
// features apply to every model written in this language.
grammar no.ntnu.tdt4250.rango.gamemode.dsl.RangoMode with org.eclipse.xtext.common.Terminals

import "http://www.ntnu.no/tdt4250/rango/gamemode/1.0"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// ---------------------------------------------------------------------------------------------
// The edition: the building blocks of the product, its default drop tables, its difficulties,
// and its game modes, in any order.

Edition returns Edition:
	'edition' name=ID (title=STRING)?
	(	enemyTypes+=EnemyType
	|	powerUps+=PowerUp
	|	players+=PlayerProfile
	|	Drops
	|	difficulties+=Difficulty
	|	modes+=GameMode
	)*;

// ---------------------------------------------------------------------------------------------
// Difficulties: what each tier multiplies, in every game mode of the edition. A value without
// a modifier stays as modelled.
//
//   difficulty hard {
//       enemy.speed * 1.3
//       player.health * 0.5
//   }

Difficulty returns Difficulty:
	'difficulty' tier=DifficultyTier '{' (modifiers+=Modifier)* '}';

enum DifficultyTier returns DifficultyTier:
	EASY='easy' | MEDIUM='medium' | HARD='hard';

Modifier returns Modifier:
	target=ModifierTarget '*' factor=Decimal;

enum ModifierTarget returns ModifierTarget:
	ENEMY_SPEED='enemy.speed' | ENEMY_POINTS='enemy.points' | PLAYER_HEALTH='player.health'
	| PLAYER_SPEED='player.speed' | DROP_CHANCE='drop.chance' | WAVE_DELAY='wave.delay';

// ---------------------------------------------------------------------------------------------
// Enemy types: tuning in any order, then what happens on a pop and on contact with the player.
//
//   enemy Cactus {
//       sprite "Enemy/Cactus.png" scale 1.2 points 15
//       on pop: split into 1
//       on contact: damage 1, poison 1 every 2 s for 6 s
//   }

EnemyType returns EnemyType:
	'enemy' name=ID '{'
	(	('sprite' sprite=STRING)
	&	('scale' scale=Decimal)?
	&	('bounce' bounce=Decimal)?
	&	('speed' speed=Decimal)?
	&	('points' points=INT)?
	)
	'on' 'pop' ':' splitRule=SplitRule
	'on' 'contact' ':' contactEffects+=PlayerEffect (',' contactEffects+=PlayerEffect)*
	'}';

SplitRule returns SplitRule:
	Vanish | Split;

Vanish returns Vanish:
	{Vanish} 'vanish';

// The number of fragments decides the pattern: two fan out as in the original game, eight or more
// fly off all around the popped enemy.
Split returns Split:
	'split' 'into' fragments=INT (fragmentType=[EnemyType])? ('launched' 'at' launchSpeed=Decimal)?;

// ---------------------------------------------------------------------------------------------
// Effects on the player, shared by enemy contacts and power-ups.

PlayerEffect returns PlayerEffect:
	Damage | Heal | Shield | SpeedChange | Poison;

Damage returns Damage:
	'damage' amount=INT;

Heal returns Heal:
	'heal' amount=INT;

Shield returns Shield:
	'shield' 'for' duration=Decimal 's';

SpeedChange returns SpeedChange:
	'speed' '*' factor=Decimal 'for' duration=Decimal 's';

Poison returns Poison:
	'poison' amount=INT 'every' interval=Decimal 's' 'for' duration=Decimal 's';

// ---------------------------------------------------------------------------------------------
// Power-ups and player profiles.

PowerUp returns PowerUp:
	'powerup' name=ID '{'
	'sprite' sprite=STRING
	'gives' ':' effects+=PlayerEffect (',' effects+=PlayerEffect)*
	'}';

PlayerProfile returns PlayerProfile:
	'player' name=ID '{'
	(	('character' character=STRING)?
	&	('health' health=INT ('max' maxHealth=INT)?)
	&	('speed' speed=Decimal)?
	&	('tongue' tongueTime=Decimal 's')?
	&	('cooldown' cooldown=Decimal 's')?
	&	('grace' graceTime=Decimal 's')?
	)
	'}';

// ---------------------------------------------------------------------------------------------
// Game modes. A mode is played in one or more levels: a mode of one level just gives its arena and
// spawning, a mode of several levels gives them per level, in the order they are played.
//
//   mode Campaign "Campaign" {
//       player Rango
//       level "First steps" {
//           arena { background "Desert" }
//           layout { Tumbleweed size 2 at (60%, 40%) moving left }
//       }
//       level { ... }
//       win when all enemies cleared
//       lose when health depleted
//   }

GameMode returns GameMode:
	'mode' name=ID title=STRING '{'
	('description' description=STRING)?
	'player' player=[PlayerProfile]
	(	('gravity' gravity=Decimal)?
	&	(speedBonus=SpeedBonus)?
	)
	(levels+=SingleLevel | levels+=Level+)
	Drops?
	('win' 'when' winConditions+=EndCondition ('or' winConditions+=EndCondition)*)?
	'lose' 'when' loseConditions+=EndCondition ('or' loseConditions+=EndCondition)*
	'}';

// The only level of a mode, written without a level block.
SingleLevel returns Level:
	arena=Arena
	spawning=SpawnStrategy;

Level returns Level:
	'level' (title=STRING)? '{'
	arena=Arena
	spawning=SpawnStrategy
	'}';

// Early pops are worth more, e.g. "speed bonus up to 2 times over 60 s". Without it, a pop is worth
// the points of its enemy type.

SpeedBonus returns SpeedBonus:
	{SpeedBonus} 'speed' 'bonus' ('up' 'to' maxFactor=Decimal 'times')? ('over' duration=Decimal 's')?;

// ---------------------------------------------------------------------------------------------
// The arena of a level. Positions are percentages of the arena: (0%, 0%) is the left end of the floor.

Arena returns Arena:
	'arena' '{'
	'background' background=STRING
	('player' 'starts' 'at' playerStart=Decimal '%')?
	(obstacles+=Obstacle)*
	'}';

fragment At returns Positioned:
	'at' '(' x=Decimal '%' ',' y=Decimal '%' ')';

Obstacle returns Obstacle:
	Block | JumpPad | Teleporter;

Block returns Block:
	'block' name=ID At 'size' width=INT 'by' height=INT;

JumpPad returns JumpPad:
	'jumppad' name=ID At 'launch' launch=Decimal ('affects' affects=Target)?;

Teleporter returns Teleporter:
	'teleporter' name=ID At 'to' target=[Teleporter] ('affects' affects=Target)?;

enum Target returns Target:
	ALL='everything' | ENEMIES='enemies' | PLAYER='player';

// ---------------------------------------------------------------------------------------------
// Spawning: a fixed layout, or waves.
//
//   waves looping escalate by 1 {
//       wave { 2 * Tumbleweed size 3 at (50%, 70%) moving left }
//       wave after 3 s { Bomb size 2 at (30%, 80%) }
//   }

SpawnStrategy returns SpawnStrategy:
	FixedLayout | WaveSchedule;

FixedLayout returns FixedLayout:
	'layout' '{' (spawns+=EnemySpawn)+ '}';

WaveSchedule returns WaveSchedule:
	'waves' (loop?='looping' ('escalate' 'by' escalation=INT)?)? '{' (waves+=Wave)+ '}';

Wave returns Wave:
	'wave' ('after' delay=Decimal 's')? '{' (spawns+=EnemySpawn)+ '}';

EnemySpawn returns EnemySpawn:
	(count=INT '*')? type=[EnemyType] 'size' size=INT At ('moving' direction=Direction)?;

enum Direction returns Direction:
	LEFT='left' | RIGHT='right';

// ---------------------------------------------------------------------------------------------
// Drops and end conditions. Each enemy type has its own drop table: the chance that popping it drops
// a power-up, and which power-up, by weight. The tables of a mode replace those of the edition.
//
//   drops {
//       Bomb       40% { Shield weight 2, Health }
//       Tumbleweed  5% { Health }
//   }

fragment Drops*:
	'drops' '{' drops+=DropTable+ '}';

DropTable returns DropTable:
	enemyType=[EnemyType] chance=Decimal '%' '{' entries+=Drop (',' entries+=Drop)* '}';

Drop returns Drop:
	powerUp=[PowerUp] ('weight' weight=INT)?;

EndCondition returns EndCondition:
	Cleared | TimeReached | ScoreReached | EnemiesPopped | WavesSurvived | HealthDepleted | EnemiesAlive;

Cleared returns Cleared:
	{Cleared} 'all' 'enemies' 'cleared';

TimeReached returns TimeReached:
	'time' 'reaches' seconds=Decimal 's';

ScoreReached returns ScoreReached:
	'score' 'reaches' points=INT;

EnemiesPopped returns EnemiesPopped:
	count=INT 'enemies' 'popped';

WavesSurvived returns WavesSurvived:
	count=INT 'waves' 'survived';

HealthDepleted returns HealthDepleted:
	{HealthDepleted} 'health' 'depleted';

EnemiesAlive returns EnemiesAlive:
	count=INT 'enemies' 'alive';

// ---------------------------------------------------------------------------------------------

Decimal returns ecore::EFloat:
	INT ('.' INT)?;
