module no.ntnu.tdt4250.rango.gamemode.dsl.GenerateRangoMode

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {

	bean = org.eclipse.emf.mwe.utils.StandaloneSetup {
		scanClassPath = true
		platformUri = rootPath
		registerGeneratedEPackage = "no.ntnu.tdt4250.rango.gamemode.GamemodePackage"
		registerGenModelFile = "platform:/resource/no.ntnu.tdt4250.rango.gamemode/model/gamemode.genmodel"
	}

	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "no.ntnu.tdt4250.rango.gamemode.dsl"
				rootPath = rootPath
				runtimeTest = {
					enabled = true
				}
				eclipsePlugin = {
					enabled = true
				}
				eclipsePluginTest = {
					enabled = false
				}
				genericIde = {
					enabled = true
				}
				createEclipseMetaData = true
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "no.ntnu.tdt4250.rango.gamemode.dsl.RangoMode"
			fileExtensions = "rango"
			referencedResource = "platform:/resource/no.ntnu.tdt4250.rango.gamemode/model/gamemode.genmodel"

			serializer = {
				generateStub = false
			}
			validator = {
				generateDeprecationValidation = false
			}
			generator = {
				generateXtendStub = true
				generateJavaMain = true
			}
			formatter = {
				generateStub = true
				generateXtendStub = true
			}
			junitSupport = {
				junitVersion = "6"
				generateStub = false
			}
		}
	}
}
