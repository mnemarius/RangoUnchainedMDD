package no.ntnu.tdt4250.rango.gamemode.dsl.generator

import no.ntnu.tdt4250.rango.gamemode.BallsAlive
import no.ntnu.tdt4250.rango.gamemode.BallsPopped
import no.ntnu.tdt4250.rango.gamemode.Burst
import no.ntnu.tdt4250.rango.gamemode.Cleared
import no.ntnu.tdt4250.rango.gamemode.Damage
import no.ntnu.tdt4250.rango.gamemode.DropTable
import no.ntnu.tdt4250.rango.gamemode.FixedLayout
import no.ntnu.tdt4250.rango.gamemode.GameMode
import no.ntnu.tdt4250.rango.gamemode.Heal
import no.ntnu.tdt4250.rango.gamemode.HealthDepleted
import no.ntnu.tdt4250.rango.gamemode.JumpPad
import no.ntnu.tdt4250.rango.gamemode.Poison
import no.ntnu.tdt4250.rango.gamemode.ScoreReached
import no.ntnu.tdt4250.rango.gamemode.Shield
import no.ntnu.tdt4250.rango.gamemode.SpeedChange
import no.ntnu.tdt4250.rango.gamemode.SpeedBonus
import no.ntnu.tdt4250.rango.gamemode.Split
import no.ntnu.tdt4250.rango.gamemode.Teleporter
import no.ntnu.tdt4250.rango.gamemode.TimeReached
import no.ntnu.tdt4250.rango.gamemode.Vanish
import no.ntnu.tdt4250.rango.gamemode.WaveSchedule
import no.ntnu.tdt4250.rango.gamemode.WavesSurvived

import static extension no.ntnu.tdt4250.rango.gamemode.dsl.generator.GeneratorNames.*

/**
 * Generates the Java class of a game mode: a subclass of the game's {@code GameModeDefinition} whose
 * methods carry out the rules of the mode. Every rule of the model becomes code here: split rules
 * become calls that create fragments, effects become calls on the player, drop tables become
 * weighted rolls, waves become spawn calls, and end conditions become the boolean expressions that
 * decide when a round is won or lost.
 */
class ModeClassTemplate {

	def generate(GameMode mode, String source) '''
		/*
		 * Generated by the Rango Unchained game mode generator from «source».
		 * Do not edit: change the model and generate again.
		 */
		package «PACKAGE»;

		import io.github.RangoUnchained.Modes.ArenaBuilder;
		import io.github.RangoUnchained.Modes.BallKind;
		import io.github.RangoUnchained.Modes.BallState;
		import io.github.RangoUnchained.Modes.GameModeDefinition;
		import io.github.RangoUnchained.Modes.ModeContext;
		import io.github.RangoUnchained.Modes.ModeStats;
		import io.github.RangoUnchained.Modes.PlayerSpec;
		import io.github.RangoUnchained.Modes.Spawner;

		/**
		 * «mode.title.comment»«IF mode.description !== null»: «mode.description.comment»«ENDIF»
		 «IF mode.popsToClear >= 0»
		 * <p>
		 * Clearing everything takes «mode.popsToClear» pops and is worth «mode.maxScore» points before bonuses.
		 «ENDIF»
		 */
		public final class «mode.className» extends GameModeDefinition {

		    private static final PlayerSpec PLAYER = new PlayerSpec(«mode.player.character.javaString», «mode.player.health», «mode.player.maxHealth»,
		        «mode.player.speed.javaFloat», «mode.player.tongueTime.javaFloat», «mode.player.cooldown.javaFloat», «mode.player.graceTime.javaFloat»);

		    «FOR type : mode.ballTypes»
		    private static final BallKind «type.constant» = new BallKind(«type.name.javaString», «type.sprite.javaString»,
		        «type.scale.javaFloat», «type.bounce.javaFloat», «type.speed.javaFloat»);
		    «ENDFOR»

		    @Override
		    public String id() {
		        return «mode.name.javaString»;
		    }

		    @Override
		    public String title() {
		        return «mode.title.javaString»;
		    }

		    @Override
		    public String description() {
		        return «mode.description.javaString»;
		    }

		    @Override
		    public String arenaFile() {
		        return «mode.arenaResource.javaString»;
		    }

		    @Override
		    public PlayerSpec player() {
		        return PLAYER;
		    }

		    @Override
		    public float gravity() {
		        return «mode.gravity.javaFloat»;
		    }

		    @Override
		    public BallKind ballKind(String name) {
		        if (name == null) {
		            return null;
		        }
		        switch (name) {
		            «FOR type : mode.ballTypes»
		            case «type.name.javaString»:
		                return «type.constant»;
		            «ENDFOR»
		            default:
		                return null;
		        }
		    }

		    @Override
		    public String powerUpSprite(String name) {
		        «IF mode.powerUps.empty»
		        return null; // nothing drops in this mode
		        «ELSE»
		        if (name == null) {
		            return null;
		        }
		        switch (name) {
		            «FOR powerUp : mode.powerUps»
		            case «powerUp.name.javaString»:
		                return «powerUp.sprite.javaString»;
		            «ENDFOR»
		            default:
		                return null;
		        }
		        «ENDIF»
		    }

		    @Override
		    public float materialBounce(String material) {
		        «IF mode.materials.empty»
		        return 1f; // the arena is neutral
		        «ELSE»
		        if (material == null) {
		            return 1f;
		        }
		        switch (material) {
		            «FOR material : mode.materials»
		            case «material.name.javaString»:
		                return «material.bounce.javaFloat»;
		            «ENDFOR»
		            default:
		                return 1f;
		        }
		        «ENDIF»
		    }

		    @Override
		    public void buildArena(ArenaBuilder arena) {
		        «FOR pad : mode.arena.obstacles.filter(JumpPad)»
		        arena.jumpPad(«pad.name.javaString», «pad.x.javaFloat», «pad.y.javaFloat», «pad.launch.javaFloat», «pad.affects.balls», «pad.affects.player»);
		        «ENDFOR»
		        «FOR teleporter : mode.arena.obstacles.filter(Teleporter)»
		        arena.teleporter(«teleporter.name.javaString», «teleporter.x.javaFloat», «teleporter.y.javaFloat», «teleporter.target.name.javaString», «teleporter.affects.balls», «teleporter.affects.player»);
		        «ENDFOR»
		    }

		    @Override
		    public int waveCount() {
		        return «mode.waves.size»;
		    }

		    @Override
		    public boolean loopsWaves() {
		        return «(mode.spawning instanceof WaveSchedule) && (mode.spawning as WaveSchedule).loop»;
		    }

		    @Override
		    public float waveDelay(int wave) {
		        «IF mode.waves.empty»
		        return 0f;
		        «ELSE»
		        switch (wave) {
		            «FOR wave : mode.waves»
		            case «wave.number - 1»:
		                return «wave.delay.javaFloat»;
		            «ENDFOR»
		            default:
		                return 0f;
		        }
		        «ENDIF»
		    }

		    @Override
		    public void spawnWave(int wave, int cycle, Spawner spawner) {
		        «spawnWaves(mode.spawning, mode)»
		    }

		    @Override
		    public void onBallPopped(BallState ball, ModeContext context) {
		        switch (ball.kind) {
		            «FOR type : mode.ballTypes»
		            case «type.name.javaString»:
		                «IF type.points > 0»
		                context.addScore(«type.points»«mode.speedBonus.factor»);
		                «ENDIF»
		                «pop(type.splitRule)»
		                «FOR table : mode.effectiveDrops.filter[ballType == type]»
		                «drop(table)»
		                «ENDFOR»
		                break;
		            «ENDFOR»
		            default:
		                break;
		        }
		    }

		    @Override
		    public void onBallTouchesPlayer(BallState ball, ModeContext context) {
		        switch (ball.kind) {
		            «FOR type : mode.ballTypes»
		            case «type.name.javaString»:
		                «FOR effect : type.contactEffects»
		                «effect(effect, type.sprite)»
		                «ENDFOR»
		                break;
		            «ENDFOR»
		            default:
		                break;
		        }
		    }

		    @Override
		    public void onPowerUpCaught(String powerUp, ModeContext context) {
		        «IF mode.powerUps.empty»
		        // nothing drops in this mode
		        «ELSE»
		        switch (powerUp) {
		            «FOR powerUp : mode.powerUps»
		            case «powerUp.name.javaString»:
		                «FOR effect : powerUp.effects»
		                «effect(effect, powerUp.sprite)»
		                «ENDFOR»
		                break;
		            «ENDFOR»
		            default:
		                break;
		        }
		        «ENDIF»
		    }

		    @Override
		    public boolean isWon(ModeStats stats) {
		        «IF mode.winConditions.empty»
		        return false; // endless: a round only ends when it is lost
		        «ELSE»
		        return «FOR condition : mode.winConditions SEPARATOR '\n    || '»«check(condition)»«ENDFOR»;
		        «ENDIF»
		    }

		    @Override
		    public boolean isLost(ModeStats stats) {
		        return «FOR condition : mode.loseConditions SEPARATOR '\n    || '»«check(condition)»«ENDFOR»;
		    }
		}
	'''

	def dispatch spawnWaves(FixedLayout layout, GameMode mode) '''
		// all balls are placed at the start by the arena resource «mode.arenaResource»
	'''

	def dispatch spawnWaves(WaveSchedule schedule, GameMode mode) '''
		«IF schedule.escalation > 0»
		int extra = cycle * «schedule.escalation»;
		«ENDIF»
		switch (wave) {
		    «FOR wave : schedule.waves»
		    case «wave.number - 1»:
		        «FOR spawn : wave.spawns»
		        spawner.spawn(«spawn.type.name.javaString», «spawn.size», «spawn.count»«IF schedule.escalation > 0» + extra«ENDIF», «spawn.x.javaFloat», «spawn.y.javaFloat», «spawn.direction.getName»);
		        «ENDFOR»
		        break;
		    «ENDFOR»
		    default:
		        break;
		}
	'''

	def dispatch pop(Vanish rule) '''
		// vanishes at once, whatever its size
	'''

	def dispatch pop(Split rule) '''
		context.split(ball, «rule.resultType.name.javaString», «rule.fragments», «rule.launchSpeed.javaFloat»);
	'''

	def dispatch pop(Burst rule) '''
		context.burst(ball, «rule.resultType.name.javaString», «rule.fragments», «rule.launchSpeed.javaFloat»);
	'''

	/** The factor a pop's points are multiplied by: the shrinking speed bonus, if the mode has one. */
	def factor(SpeedBonus bonus) {
		if (bonus === null) '' else ''' * context.speedBonus(«bonus.maxFactor.javaFloat», «bonus.duration.javaFloat»)'''
	}

	/** The roll of a ball type's drop table: whether the pop drops anything, then which power-up. */
	def drop(DropTable table) '''
		if (context.random() * 100f < «table.chance.javaFloat») { // «table.chance.percent» % of «table.ballType.name» pops drop something
		    «IF table.entries.size == 1»
		    context.dropPowerUp(«table.entries.head.powerUp.name.javaString», ball);
		    «ELSE»
		    float roll = context.random() * «table.totalWeight»;
		    «FOR i : 0 ..< table.entries.size»
		    «IF i == 0»if (roll < «table.threshold(i)») {«ELSEIF i < table.entries.size - 1»} else if (roll < «table.threshold(i)») {«ELSE»} else {«ENDIF»
		        context.dropPowerUp(«table.entries.get(i).powerUp.name.javaString», ball); // «table.entries.get(i).share.percent» % of drops, «table.entries.get(i).probability.percent» % of pops
		    «ENDFOR»
		    }
		    «ENDIF»
		}
	'''

	def dispatch effect(Damage effect, String icon) '''
		context.damage(«effect.amount»);
	'''

	def dispatch effect(Heal effect, String icon) '''
		context.heal(«effect.amount»);
	'''

	def dispatch effect(Shield effect, String icon) '''
		context.shield(«effect.duration.javaFloat», «icon.javaString»);
	'''

	def dispatch effect(SpeedChange effect, String icon) '''
		context.changeSpeed(«effect.factor.javaFloat», «effect.duration.javaFloat», «icon.javaString»);
	'''

	def dispatch effect(Poison effect, String icon) '''
		context.poison(«effect.amount», «effect.interval.javaFloat», «effect.duration.javaFloat», «icon.javaString»);
	'''

	def dispatch check(Cleared condition) '''stats.cleared()'''

	def dispatch check(TimeReached condition) '''stats.elapsed() >= «condition.seconds.javaFloat»'''

	def dispatch check(ScoreReached condition) '''stats.score() >= «condition.points»'''

	def dispatch check(BallsPopped condition) '''stats.popped() >= «condition.count»'''

	def dispatch check(WavesSurvived condition) '''stats.wavesCleared() >= «condition.count»'''

	def dispatch check(HealthDepleted condition) '''stats.playerHealth() <= 0'''

	def dispatch check(BallsAlive condition) '''stats.ballsAlive() >= «condition.count»'''
}
