// The smallest valid product: the round the original game plays. One ball type that splits in two,
// a player with three hearts, a neutral arena, and the one power-up every ball must be able to drop.
// Won by popping everything, lost when the hearts run out. Only the mandatory parts of the metamodel
// are configured.

edition Classic "Rango Unchained"

ball Tumbleweed {
	sprite "Ball/Tumbleweed.png"
	on pop: split into 2
	on contact: damage 1
}

powerup Health {
	sprite "Powerup/Health.png"
	gives: heal 1
}

drops {
	Tumbleweed 5% { Health }
}

player Rango {
	health 3
}

mode ClassicRound "Classic Round" {
	description "Pop the tumbleweed and everything it splits into."
	player Rango
	arena {
		background "Desert"
	}
	layout {
		Tumbleweed size 3 at (70%, 60%) moving left
	}
	win when all balls cleared
	lose when health depleted
}
